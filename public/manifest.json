{
  "manifest_version": 3,
  "name": "VisionText CN",
  "version": "1.0.0",
  "description": "OCR and Translate Chinese text from images directly in your browser.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "VisionText CN"
  }
}
